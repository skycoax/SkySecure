<?xml version="1.0" encoding="utf-8"?>
<!--
  Humogram: the adaptive-icon background.

  Was a layer-list assembling Telegram's plane artwork from a shape plus a
  clipping mipmap. There is nothing left to assemble: the whole subject is the
  bird in the foreground layer, so the background is only the colour it flies
  against, and a shape drawable renders that at any size with no assets.

  The gradient matches the master artwork (lighter top-left, deeper
  bottom-right) so the adaptive icon and the legacy PNG do not read as two
  different blues on the same home screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#38B2FD"
        android:endColor="#0A7AE2"
        android:type="linear" />
</shape>
